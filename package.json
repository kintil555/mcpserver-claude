{
  "name": "@kintil555/mcp-github-push",
  "version": "1.0.1",
  "description": "MCP server ringan untuk push project ke GitHub langsung via REST API (tanpa git clone lokal) — dilengkapi CLI setup token dan konfirmasi sebelum push.",
  "type": "module",
  "license": "MIT",
  "author": "kintil555",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kintil555/mcpserver-claude.git"
  },
  "bin": {
    "mcp-github-push": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@octokit/rest": "^21.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "claude",
    "git",
    "push",
    "cli"
  ]
}
